This project's changes to ArduPilot's SITL_Models (https://github.com/ArduPilot/SITL_Models),
made against its commit 25bc38e: the Mini Talon V-Tail gets a nose camera that streams
H.264 to UDP 5600, and the runway world the sensors system cameras need, a location near
Erzurum and a QR target (sim/models). Apply with:

    git -C ~/gz_ws/src/SITL_Models apply "$PWD/sim/sitl_models.patch"

diff --git a/Gazebo/models/mini_talon_vtail/model.sdf b/Gazebo/models/mini_talon_vtail/model.sdf
index 2ffd908..1ea4aa3 100644
--- a/Gazebo/models/mini_talon_vtail/model.sdf
+++ b/Gazebo/models/mini_talon_vtail/model.sdf
@@ -321,6 +321,29 @@
         <always_on>1</always_on>
         <update_rate>1</update_rate>
       </sensor>
+      <sensor name="nose_camera" type="camera">
+        <pose>0.38 0 0 0 0 0</pose>
+        <camera>
+          <horizontal_fov>1.13</horizontal_fov>
+          <image>
+            <width>640</width>
+            <height>480</height>
+          </image>
+          <clip>
+            <near>0.1</near>
+            <far>15000</far>
+          </clip>
+        </camera>
+        <always_on>1</always_on>
+        <update_rate>20</update_rate>
+        <visualize>1</visualize>
+        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
+          <udp_host>127.0.0.1</udp_host>
+          <udp_port>5600</udp_port>
+          <use_basic_pipeline>false</use_basic_pipeline>
+          <use_cuda>false</use_cuda>
+        </plugin>
+      </sensor>
     </link>
 
     <link name="main_wheel_link">
diff --git a/Gazebo/worlds/vtail_runway.sdf b/Gazebo/worlds/vtail_runway.sdf
index f822ee5..bb8879b 100755
