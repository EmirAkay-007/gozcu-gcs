+<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
     <plugin filename="gz-sim-physics-system"
       name="gz::sim::systems::Physics">
     </plugin>
@@ -29,9 +30,9 @@
     </scene>
 
     <spherical_coordinates>
-      <latitude_deg>-35.363262</latitude_deg>
-      <longitude_deg>149.165237</longitude_deg>
-      <elevation>584</elevation>
+      <latitude_deg>39.9035714</latitude_deg>
+      <longitude_deg>41.2375758</longitude_deg>
+      <elevation>1850</elevation>
       <heading_deg>0</heading_deg>
       <surface_model>EARTH_WGS84</surface_model>
     </spherical_coordinates>
@@ -111,5 +112,11 @@
       <uri>model://mini_talon_vtail</uri>
     </include>
 
+    <include>
+      <uri>model://qr_2027_kamikaze</uri>
+      <name>qr_2027_kamikaze</name>
+      <pose>-48.019 101.848 0.005 0 0 0</pose>
+    </include>
+
   </world>
 </sdf>
